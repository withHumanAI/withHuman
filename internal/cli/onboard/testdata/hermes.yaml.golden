# Hermes
model: hermes-4
hooks:
  pre_tool_call:
    - command: audit --pre
      timeout: 10
    - command: AAP_CONFIG_DIR={{CONFIG}} {{BINARY}} hook hermes
      timeout: 300
      fail_closed: true
plugins:
  hook_callback_timeout: 330
mcp_servers:
  withhuman:
    command: {{BINARY}}
    args:
      - mcp
      - hermes
      - withhuman
    env:
      WITHHUMAN_CONFIG_DIR: {{WITHHUMAN_CONFIG}}
