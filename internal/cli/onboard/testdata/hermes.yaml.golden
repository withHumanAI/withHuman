# Hermes
model: hermes-4
hooks:
  pre_tool_call:
    - command: audit --pre
      timeout: 10
plugins:
  hook_callback_timeout: 0
  enabled:
    - withhuman
mcp_servers:
  withhuman:
    command: {{BINARY}}
    args:
      - mcp
      - hermes
      - withhuman
    env:
      WITHHUMAN_CONFIG_DIR: {{WITHHUMAN_CONFIG}}
