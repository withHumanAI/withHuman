# Settings for the withhuman server, for `docker run --env-file`.
# Every setting is optional; see the README's Configuration section.

# The exact origin people use to reach the server.
WITHHUMAN_PUBLIC_ORIGIN=http://localhost:8080

# The secret for creating the first owner. Generated into the data
# directory when unset.
WITHHUMAN_BOOTSTRAP_SECRET=

# CIDRs of the reverse proxies in front of the server, comma separated.
WITHHUMAN_TRUSTED_PROXIES=

# Encrypts stored secrets; required for webhook blocks, Slack and
# asynchronous agent replies. 32 random bytes, URL-safe base64:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
WITHHUMAN_SECRETS_KEY=

# Email for invitations, password resets and notifications. Set the host
# and the sender together.
WITHHUMAN_SMTP_HOST=
WITHHUMAN_SMTP_PORT=587
WITHHUMAN_SMTP_USERNAME=
WITHHUMAN_SMTP_PASSWORD=
WITHHUMAN_SMTP_FROM=

# Slack notifications: one Slack app per deployment, all four values
# together, plus WITHHUMAN_SECRETS_KEY. See deployment/slack.
WITHHUMAN_SLACK_APP_ID=
WITHHUMAN_SLACK_CLIENT_ID=
WITHHUMAN_SLACK_CLIENT_SECRET=
WITHHUMAN_SLACK_SIGNING_SECRET=

# Discord notifications: all three values together. See deployment/discord.
WITHHUMAN_DISCORD_CLIENT_ID=
WITHHUMAN_DISCORD_CLIENT_SECRET=
WITHHUMAN_DISCORD_BOT_TOKEN=
